# Token du bot Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=

# ID de la guild (serveur) où synchroniser les commandes slash
GUILD_ID=

# ID Discord du superadmin (accès complet au dashboard)
SUPERADMIN_ID=

# API + dashboard
PORT=3001
HOST=127.0.0.1

# Contournement du blocage YouTube sur IP datacenter (optionnel)
# URL du provider POT, ex: conteneur bgutil-ytdlp-pot-provider
# Endpoint CDP d'un navigateur pour exporter les cookies (défaut : http://127.0.0.1:9222)
# YTDLP_BROWSER_CDP=http://127.0.0.1:9222
# Fichier de cookies Netscape de secours, optionnel (défaut : data/shared-cookies.txt)
# YTDLP_SHARED_COOKIES=/opt/bardbot/data/shared-cookies.txt
