[Unit]
Description=Bardbot — bot Discord musique D&D (dashboard + lecture)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# Créer un utilisateur dédié : sudo useradd --system --home /opt/bardbot --shell /usr/sbin/nologin bardbot
User=bardbot
WorkingDirectory=/opt/bardbot
ExecStart=/usr/bin/env node src/index.js
Restart=on-failure
RestartSec=10
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# Durcir un peu
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
